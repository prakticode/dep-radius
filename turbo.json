{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!tests/**",
        "!dist/**",
        "!.turbo/**",
        "!node_modules/**"
      ],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!dist/**",
        "!.turbo/**",
        "!node_modules/**"
      ]
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!dist/**",
        "!.turbo/**",
        "!node_modules/**"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!dist/**",
        "!.turbo/**",
        "!node_modules/**"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "interactive": true
    },
    "clean": {
      "cache": false
    }
  }
}
